<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_asset_asset_view_form_legacy_import" model="ir.ui.view">
        <field name="name">account.asset.asset.form.legacy.import</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="base_accounting_kit.account_asset_asset_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Legacy Migration" name="legacy_migration">
                    <group>
                        <group>
                            <field name="legacy_import_key" readonly="1"/>
                            <field name="legacy_cutover_date" readonly="1"/>
                            <field name="legacy_force_salvage_value_one" readonly="1"/>
                        </group>
                        <group>
                            <field name="legacy_accumulated_depreciation"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                            <field name="legacy_carrying_value"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="account_asset_asset_view_tree_legacy_import" model="ir.ui.view">
        <field name="name">account.asset.asset.list.legacy.import</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="base_accounting_kit.account_asset_asset_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="legacy_import_key" optional="hide"/>
            </field>
            <field name="value" position="after">
                <field name="legacy_accumulated_depreciation"
                       widget="monetary"
                       optional="show"/>
                <field name="legacy_carrying_value"
                       widget="monetary"
                       optional="show"/>
            </field>
        </field>
    </record>
</odoo>
