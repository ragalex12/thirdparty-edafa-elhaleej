<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="view_move_form_inherit_line_references" model="ir.ui.view">
			<field name="name">account.move.form.inherit.line.references</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_move_form"/>
			<field name="arch" type="xml">
				<xpath expr="//page[@id='aml_tab']//field[@name='journal_line_ids']/list/field[@name='partner_id']" position="after">
					<field name="line_reference" optional="show" column_invisible="parent.move_type != 'entry'"/>
					<field name="line_reference_number" optional="show" column_invisible="parent.move_type != 'entry'"/>
					<field name="line_tax_number" optional="show" column_invisible="parent.move_type != 'entry'"/>
				</xpath>
				<xpath expr="//page[@id='aml_tab']//field[@name='journal_line_ids']/form//field[@name='partner_id']" position="after">
					<field name="line_reference" invisible="parent.move_type != 'entry'"/>
					<field name="line_reference_number" invisible="parent.move_type != 'entry'"/>
					<field name="line_tax_number" invisible="parent.move_type != 'entry'"/>
				</xpath>
			</field>
		</record>

		<record id="view_move_line_tree_inherit_line_references" model="ir.ui.view">
			<field name="name">account.move.line.tree.inherit.line.references</field>
			<field name="model">account.move.line</field>
			<field name="inherit_id" ref="account.view_move_line_tree"/>
			<field name="arch" type="xml">
				<xpath expr="//list[@name='move_line_tree']/field[@name='partner_id']" position="after">
					<field name="line_reference" optional="show"/>
					<field name="line_reference_number" optional="show"/>
					<field name="line_tax_number" optional="show"/>
				</xpath>
			</field>
		</record>
	</data>
</odoo>
