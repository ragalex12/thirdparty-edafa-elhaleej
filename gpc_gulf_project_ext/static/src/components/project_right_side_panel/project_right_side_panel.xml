<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="gpc_gulf_project_ext.ProjectRightSidePanel"
       t-inherit="project.ProjectRightSidePanel"
       t-inherit-mode="extension">
        <xpath expr="(//ProjectRightSidePanelSection)[1]" position="after">
            <ProjectRightSidePanelSection
                name="'project_details'"
                show="state.data.show_project_details and (hasDescription or hasContractAmount)"
            >
                <t t-set-slot="title">
                    Project Details
                </t>
                <div class="px-3 pb-3">
                    <div t-if="hasContractAmount" class="mb-3">
                        <strong>Contract Amount / مبلغ التعاقد</strong>
                        <div class="o_stat_value text-primary">
                            <t t-esc="formatMonetary(state.data.contract_amount)"/>
                        </div>
                    </div>
                    <div t-if="hasDescription">
                        <strong>Description / الوصف</strong>
                        <div class="mt-2 o_gpc_project_description" t-out="descriptionMarkup"/>
                    </div>
                </div>
            </ProjectRightSidePanelSection>
        </xpath>
    </t>

</templates>
