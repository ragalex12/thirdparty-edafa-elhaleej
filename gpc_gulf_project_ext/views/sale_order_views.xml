<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_gpc_gulf_dimensions" model="ir.ui.view">
        <field name="name">sale.order.form.gpc.gulf.dimensions</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="length_cm" optional="show"/>
                <field name="width_cm" optional="show"/>
                <field name="area_sqm" optional="show" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="before">
                <label for="length_cm" string="Length (CM)"/>
                <field name="length_cm"/>
                <label for="width_cm" string="Width/Height (CM)"/>
                <field name="width_cm"/>
                <field name="area_sqm" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
