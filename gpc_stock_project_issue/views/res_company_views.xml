<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_inherit_gpc_stock_project_issue" model="ir.ui.view">
        <field name="name">res.company.form.inherit.gpc.stock.project.issue</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field
                    name="gpc_project_issue_journal_id"
                    groups="account.group_account_manager"
                    options="{'no_create': True}"
                />
                <field
                    name="gpc_project_issue_debit_account_id"
                    groups="account.group_account_manager"
                />
            </xpath>
        </field>
    </record>
</odoo>
