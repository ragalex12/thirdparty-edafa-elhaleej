<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.rule" id="no_edit_in_done_cancel_state">
        <field name="name">No Edit in done state</field>
        <field name="model_id" ref="model_project_project"/>
        <field name="groups"
               eval="[(4, ref('project.group_project_user')), (4, ref('project.group_project_manager'))]"/>
        <field eval="0" name="perm_unlink"/>
        <field eval="0" name="perm_write"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_create"/>
        <field name="domain_force">['|',('state','=','cancel'),('state', '=', 'finished')]</field>
    </record>
</odoo>
 