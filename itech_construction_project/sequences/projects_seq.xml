<?xml version="1.0" ?>
<openerp>
    <data noupdate='1'>
		<record id="ir_seq_project" model="ir.sequence">
			<field name="name">Project Code</field>
			<field name="code">project.req</field>
			<field name="prefix">PROJECT/%(year)s/</field>
			<field name="padding">4</field>
			<field name="number_increment">1</field>
			<field name="number_next_actual">1</field>
			<field name="implementation">no_gap</field>
		</record>
		<record id="ir_seq_construction_snag_list" model="ir.sequence">
			<field name="name">Construction Snag List</field>
			<field name="code">construction.snag.list</field>
			<field name="prefix">SNG/%(year)s/</field>
			<field name="padding">4</field>
			<field name="number_increment">1</field>
			<field name="number_next_actual">1</field>
			<field name="implementation">no_gap</field>
		</record>
		
	</data>
</openerp>
