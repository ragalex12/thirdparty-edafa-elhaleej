	<!--Inherit the Purchase order form view--> 
	<record id="view_purchase_order_custom" model="ir.ui.view"> 
	<field name="name">purchase.order.custom.form.inherited</field>
		 <field name="model">purchase.order</field> 
		 <field name="inherit_id" ref="purchase.purchase_order_form"/> 
		 <field name="arch" type="xml"> 
			  <xpath expr="//field[@name='partner_id']" position="after"> 
				   <field name="project_id"/>
			  </xpath> 
		 </field> 
	</record>

	<!--Inherit the invoice form view--> 
	<record id="view_invoice_custom" model="ir.ui.view"> 
	<field name="name">invoice.custom.form.inherited</field>
		 <field name="model">account.move</field> 
		 <field name="inherit_id" ref="account.view_move_form"/> 
		 <field name="arch" type="xml"> 
			  <xpath expr="//field[@name='partner_id']" position="after"> 
				   <field name="project_id"/>
                   <field name="approved_pg" groups="project.group_project_user,project.group_project_manager" readonly="state != 'draft'"/>

			  </xpath> 
		 </field> 
	</record>
