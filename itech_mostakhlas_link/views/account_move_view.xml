<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Extend Account Move Line List View for Vendor Bills -->
        <record id="view_account_move_line_list_inherit" model="ir.ui.view">
            <field name="name">account.move.line.list.inherit.boq</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <!-- Add BOQ line field to invoice lines -->
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="boq_line_id" 
                           domain="[('partner_id', '=', parent.partner_id), ('product_id', '=', product_id)]"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </xpath>
            </field>
        </record>

        <!-- Extend Account Move Form View for Vendor Bills -->
        <record id="view_account_move_form_inherit_boq" model="ir.ui.view">
            <field name="name">account.move.form.inherit.boq</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Add BOQ line field in invoice lines for vendor bills -->
                <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='product_id']" position="after">
                    <field name="boq_line_id" 
                           domain="[('partner_id', '=', parent.partner_id), ('product_id', '=', product_id), ('bill_quantity_id.project_id', '=', parent.project_id)]"
                           options="{'no_create': True, 'no_create_edit': True}"
                           context="{'default_partner_id': parent.partner_id, 'default_product_id': product_id}"
                           invisible="parent.move_type not in ['in_invoice', 'in_refund'] or not parent.project_id"/>
                </xpath>
                
                <!-- Add BOQ tracking fields in invoice lines -->
                <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='boq_line_id']" position="after">
                    <field name="boq_allocated_qty" readonly="1" optional="hide"/>
                    <field name="boq_invoiced_qty" readonly="1" optional="hide"/>
                    <field name="boq_remaining_qty" readonly="1" optional="hide"/>
                </xpath>
            </field>
        </record>

        <!-- Note: BOQ fields are added in the list view within account.move form view above -->
        <!-- The form view for account.move.line is not extended as it's not commonly used -->
    </data>
</odoo>

