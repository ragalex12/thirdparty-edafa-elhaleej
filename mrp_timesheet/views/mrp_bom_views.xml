<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Add "Update Cost (Materials + Labor)" button on BoM form -->
        <record id="mrp_bom_form_cost_button" model="ir.ui.view">
            <field name="name">mrp.bom.form.cost.button</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <!-- Add button in the button box (smart buttons area, top right) -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_update_cost_from_bom_and_labor"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calculator"
                            groups="mrp.group_mrp_manager"
                            help="Calculate and update the product's cost based on BoM materials and average labor from past Manufacturing Orders">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Update Cost<br/>(Materials + Labor)</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
