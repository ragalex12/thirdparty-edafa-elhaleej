<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Task 82 – Inline list for timesheet lines on MO (with labor cost columns) -->
        <record id="view_analytic_line_tree_mrp_timesheet" model="ir.ui.view">
            <field name="name">account.analytic.line.tree.mrp.timesheet</field>
            <field name="model">account.analytic.line</field>
            <field name="priority" eval="20"/>
            <field name="arch" type="xml">
                <list editable="bottom" string="Timesheet lines">
                    <field name="date"/>
                    <field name="user_id"/>
                    <field name="employee_id" optional="show"/>
                    <field name="name" string="Description"/>
                    <field name="unit_amount" string="Hours"/>
                    <field name="is_overtime" optional="hide"/>
                    <field name="is_holiday" optional="hide"/>
                    <field name="labor_cost_currency_id" column_invisible="1"/>
                    <field name="labor_cost" optional="show"
                           groups="account.group_account_readonly"
                           decoration-muted="labor_cost == 0"/>
                    <field name="labor_move_id" optional="hide"
                           groups="account.group_account_readonly"
                           string="JE"/>
                </list>
            </field>
        </record>

        <!-- Task 82 – MO form: smart button + analytic account + timesheets tab -->
        <record id="mrp_production_form_timesheet" model="ir.ui.view">
            <field name="name">mrp.production.form.timesheet</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">

                <!-- Smart button: shows total labor cost + JE status -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="%(mrp_timesheet.action_labor_clearing_check_wizard)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-clock-o"
                            groups="account.group_account_readonly"
                            invisible="timesheet_count == 0">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="timesheet_labor_cost"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                            </span>
                            <span class="o_stat_text">Labor Cost</span>
                        </div>
                    </button>
                </xpath>

                <!-- Analytic account + cost summary fields after product_id -->
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="analytic_account_id"
                           options="{'no_create': True}"
                           groups="analytic.group_analytic_accounting"/>
                    <field name="timesheet_labor_cost"
                           optional="show"
                           groups="account.group_account_readonly"/>
                    <field name="timesheet_cost_posted" invisible="1"/>
                    <field name="timesheet_labor_move_id"
                           optional="hide"
                           groups="account.group_account_readonly"/>
                    <field name="currency_id" invisible="1"/>
                </xpath>

                <!-- Timesheets tab with full columns -->
                <xpath expr="//notebook" position="inside">
                    <page string="Timesheets" name="timesheets">
                        <field name="timesheet_count" invisible="1"/>
                        <field name="timesheet_ids"
                               nolabel="1"
                               context="{
                                   'default_account_id': analytic_account_id,
                                   'default_mrp_production_id': id
                               }"/>
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
