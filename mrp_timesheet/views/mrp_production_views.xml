<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Tree view for timesheet lines on MO (separate view so "date" is validated on account.analytic.line) -->
        <record id="view_analytic_line_tree_mrp_timesheet" model="ir.ui.view">
            <field name="name">account.analytic.line.tree.mrp.timesheet</field>
            <field name="model">account.analytic.line</field>
            <field name="priority" eval="20"/>
            <field name="arch" type="xml">
                <list editable="bottom" string="Timesheet lines">
                    <field name="date"/>
                    <field name="user_id"/>
                    <field name="employee_id" optional="show"/>
                    <field name="name" string="Description"/>
                    <field name="unit_amount" string="Hours"/>
                </list>
            </field>
        </record>
        <!-- Add Analytic Account and Timesheets tab on Manufacturing Order form -->
        <record id="mrp_production_form_timesheet" model="ir.ui.view">
            <field name="name">mrp.production.form.timesheet</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <!-- Analytic account: add after product_id or in first column -->
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="analytic_account_id" options="{'no_create': True}" groups="analytic.group_analytic_accounting"/>
                    <field name="timesheet_labor_cost" optional="show" groups="account.group_account_readonly"/>
                    <field name="timesheet_cost_posted" invisible="1"/>
                    <field name="timesheet_labor_move_id" optional="hide" groups="account.group_account_readonly"/>
                </xpath>
                <!-- Timesheets tab: add new page inside the main notebook -->
                <xpath expr="//notebook" position="inside">
                    <page string="Timesheets" name="timesheets">
                        <field name="timesheet_count" invisible="1"/>
                        <field name="timesheet_ids" nolabel="1" context="{'default_account_id': analytic_account_id, 'default_mrp_production_id': id}"/>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
