<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Production labor expense account on company form -->
        <record id="view_company_form_production_labor" model="ir.ui.view">
            <field name="name">res.company.form.production.labor</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="production_labor_expense_account_id"
                           string="Production Labor Expense Account"
                           options="{'no_create': True}"
                           groups="account.group_account_manager"
                           help="Expense account used when posting timesheet labor cost from Manufacturing Orders (credited in the labor journal entry)."/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
