# Single source of truth for OpenProject public links (Cloudflare tunnel → localhost:8090).
# If your trycloudflare hostname changes after tunnel restart, update OPENPROJECT_PUBLIC_BASE_URL only here.
# Used by: open_openproject.sh, and as the canonical reference for copy-paste URLs.

OPENPROJECT_PUBLIC_BASE_URL="https://generated-complexity-ireland-fully.trycloudflare.com"
# Default project opened by `op` / open_openproject.sh (identifier slug)
OPENPROJECT_DEFAULT_PROJECT="odoo19-finance-acct-master-2026"

# Odoo GPC testing / staging — web login with database trgulf_Mrp (opened by `op-odoo`)
ODOO_TESTING_WEB_URL="https://gpc.odoo.com.se/web/login?redirect=%2Fodoo%3Fdb%3Dtrgulf_Mrp"
