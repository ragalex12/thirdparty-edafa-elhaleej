<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_saleorder_document_retention_performance_bond" inherit_id="sale.report_saleorder_document">
    <xpath expr="//div[@id='total']" position="after">
      <div class="mt32">
        <h3>Order Summary</h3>

        <div class="mt16">
          <strong>Contract References</strong>
          <table class="table table-sm">
            <tbody>
              <tr>
                <td>Contract No</td>
                <td><span t-esc="o.contract_ref or ''"/></td>
                <td>PO No</td>
                <td><span t-esc="o.po_ref or ''"/></td>
              </tr>
              <tr>
                <td>Inv Ref</td>
                <td><span t-esc="o.invoice_ref or ''"/></td>
                <td>Covered Period</td>
                <td><span t-esc="o.covered_period or ''"/></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="mt16">
          <strong>Financial Summary</strong>
          <table class="table table-sm">
            <tbody>
              <tr>
                <td>Gross (Untaxed)</td>
                <td><span t-field="o.gross_untaxed"/></td>
                <td></td>
                <td></td>
              </tr>
              <tr>
                <td>Tax Base After Deductions</td>
                <td><span t-field="o.tax_base_after_deductions"/></td>
                <td>Tax</td>
                <td><span t-field="o.amount_tax"/></td>
              </tr>
              <tr>
                <td>Total</td>
                <td><span t-field="o.amount_total"/></td>
                <td>Net Collect Now</td>
                <td><span t-field="o.net_collect_now"/></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="mt16">
          <strong>Performance Bond and Retention</strong>
          <table class="table table-sm">
            <tbody>
              <tr>
                <td>Performance Bond %</td>
                <td><span t-esc="'{:.2f}'.format((o.performance_bond_percent or 0.0) * 100)"/>%</td>
                <td>Performance Bond Amount</td>
                <td><span t-field="o.performance_bond_amount"/></td>
              </tr>
              <tr>
                <td>Retention %</td>
                <td><span t-esc="'{:.2f}'.format((o.retention_percent or 0.0) * 100)"/>%</td>
                <td>Retention Amount</td>
                <td><span t-field="o.retention_amount"/></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </xpath>
  </template>
</odoo>
