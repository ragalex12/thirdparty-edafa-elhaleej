<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Privilege for Workers Project Sheets -->
        <record model="res.groups.privilege" id="res_groups_workers_project_sheets">
            <field name="name">Workers Project Sheets</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
        </record>

        <!-- Security Groups -->
        <record id="group_workers_project_sheets_user" model="res.groups">
            <field name="name">Workers Project Sheets User</field>
            <field name="privilege_id" ref="res_groups_workers_project_sheets"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="group_workers_project_sheets_manager" model="res.groups">
            <field name="name">Workers Project Sheets Manager</field>
            <field name="privilege_id" ref="res_groups_workers_project_sheets"/>
            <field name="implied_ids" eval="[(4, ref('group_workers_project_sheets_user'))]"/>
        </record>
    </data>
</odoo>

