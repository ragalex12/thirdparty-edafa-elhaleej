<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Payslip Form View - Add Project Integration -->
        <record id="view_payslip_form_project" model="ir.ui.view">
            <field name="name">hr.payslip.form.project</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='employee_id']" position="after">
                    <field name="project_id" 
                           domain="[('use_for_payroll', '=', True), ('members_ids', 'in', [employee_id])]"
                           options="{'no_create': True}"/>
                    <field name="employee_day_work" 
                           invisible="not employee_day_work"/>
                </xpath>
                
                <xpath expr="//field[@name='struct_id']" position="attributes">
                    <attribute name="readonly">employee_day_work == True</attribute>
                    <attribute name="help">Automatically set to 'Workers Daily Cost' for day work employees</attribute>
                </xpath>
                
                <xpath expr="//field[@name='date_to']" position="after">
                    <field name="project_hours" readonly="1"/>
                </xpath>
                
                <xpath expr="//notebook" position="inside">
                    <page string="Project Timesheets" name="project_timesheets">
                        <field name="timesheet_ids" readonly="1">
                            <list>
                                <field name="date"/>
                                <field name="project_id"/>
                                <field name="unit_amount" string="Hours"/>
                                <field name="work_status"/>
                                <field name="work_note"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

