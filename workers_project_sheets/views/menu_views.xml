        <!-- Main Menu -->
        <menuitem id="menu_workers_project_sheets"
                  name="Workers Project Sheets"
                  sequence="10"
                  web_icon="workers_project_sheets,static/description/icon.png"/>
        
        <!-- Workers Submenu -->
        <menuitem id="menu_workers"
                  name="Workers"
                  parent="menu_workers_project_sheets"
                  action="hr.open_view_employee_list_my"
                  sequence="10"/>
        
        <!-- Projects Submenu -->
        <menuitem id="menu_payroll_projects"
                  name="Payroll Projects"
                  parent="menu_workers_project_sheets"
                  action="project.open_view_project_all"
                  sequence="20"/>
        
        <!-- Payroll Submenu -->
        <menuitem id="menu_workers_payroll"
                  name="Payroll"
                  parent="menu_workers_project_sheets"
                  sequence="30"/>
        
        <!-- Payslips -->
        <menuitem id="menu_workers_payslips"
                  name="Payslips"
                  parent="menu_workers_payroll"
                  action="hr_payroll_community.hr_payslip_action"
                  sequence="10"/>
    </data>
</odoo>

