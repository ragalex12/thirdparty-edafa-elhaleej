<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_timesheet">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2>Timesheet Report</h2>
                            <p><strong>Date From:</strong> <t t-esc="doc.date_from"/></p>
                            <p><strong>Date To:</strong> <t t-esc="doc.date_to"/></p>
                            <table class="table table-condensed">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Worker</th>
                                        <th>Project</th>
                                        <th>Hours</th>
                                        <th>Status</th>
                                        <th>Sheet Code</th>
                                        <th>Metre Qty</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="timesheets" t-value="doc._get_timesheets()"/>
                                    <t t-foreach="timesheets" t-as="timesheet">
                                        <tr>
                                            <td><t t-esc="timesheet.date"/></td>
                                            <td><t t-esc="timesheet.employee_id.name"/></td>
                                            <td><t t-esc="timesheet.project_id.name or ''"/></td>
                                            <td><t t-esc="timesheet.unit_amount"/></td>
                                            <td><t t-esc="timesheet.work_status"/></td>
                                            <td><t t-esc="timesheet.worker_sheet_code or ''"/></td>
                                            <td><t t-esc="timesheet.metre_quantity if timesheet.worker_sheet_code == 'C' else ''"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>

