<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_worker">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2>Worker Report</h2>
                            <p><strong>Report Type:</strong> <t t-esc="doc.report_type"/></p>
                            <table class="table table-condensed">
                                <thead>
                                    <tr>
                                        <th>Worker Code</th>
                                        <th>Name</th>
                                        <th>Department</th>
                                        <th>Projects</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="employees" t-value="doc._get_employees()"/>
                                    <t t-foreach="employees" t-as="employee">
                                        <tr>
                                            <td><t t-esc="employee.no_employee or employee.emp_no or ''"/></td>
                                            <td><t t-esc="employee.name"/></td>
                                            <td><t t-esc="employee.department_id.name or ''"/></td>
                                            <td><t t-esc="len(employee.project_payroll_ids)"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>

